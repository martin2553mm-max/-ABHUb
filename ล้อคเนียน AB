-- ==========================================================
-- HELPERS
-- ==========================================================
local function isSameTeam(plr)
    if not Config.TeamCheck then return false end
    return plr.Team ~= nil and plr.Team == LocalPlayer.Team
end

local function isBehindWall(fromPos, targetPart)
    if not Config.WallCheck then return false end
    if not fromPos or not targetPart then return false end

    local dir = (targetPart.Position - fromPos)
    if dir.Magnitude < 1 then return false end

    local filterList = { LocalPlayer.Character }
    if targetPart.Parent then
        table.insert(filterList, targetPart.Parent)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filterList
    params.IgnoreWater = true

    local result = Workspace:Raycast(fromPos, dir, params)
    return result ~= nil
end

local function getTargets()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and not isSameTeam(plr) then
            local head = plr.Character:FindFirstChild("Head")
            local hum  = plr.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                table.insert(list, {
                    Player   = plr,
                    Head     = head,
                    Humanoid = hum,
                })
            end
        end
    end
    return list
end

local function getClosestTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, closestDist = nil, Config.FOVSize

    local camPos = Camera.CFrame.Position

    for _, t in ipairs(getTargets()) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(t.Head.Position)
        if onScreen then
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            if dist < closestDist then
                if not isBehindWall(camPos, t.Head) then
                    closestDist = dist
                    closest = t
                end
            end
        end
    end
    return closest
end

-- ==========================================================
-- GREEN HIGHLIGHT
-- ==========================================================
local highlights = {}

local function applyGreen(player)
    if player == LocalPlayer then return end
    if not player.Character then return end

    if highlights[player] then
        pcall(function() highlights[player]:Destroy() end)
        highlights[player] = nil
    end

    local hl = Instance.new("Highlight")
    hl.Name                = "ABHubGreen"
    hl.Adornee             = player.Character
    hl.FillColor           = Color3.fromRGB(0, 255, 0)
    hl.OutlineColor        = Color3.fromRGB(0, 200, 0)
    hl.FillTransparency    = 0.4
    hl.OutlineTransparency = 0
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent              = player.Character

    highlights[player] = hl
end

local function removeGreen(player)
    if highlights[player] then
        pcall(function() highlights[player]:Destroy() end)
        highlights[player] = nil
    end
end

local function refreshAllGreen()
    for _, plr in ipairs(Players:GetPlayers()) do
        if Config.GreenPlayers then
            applyGreen(plr)
        else
            removeGreen(plr)
        end
    end
end

-- ==========================================================
-- ESP (Name + Health + Distance)
-- ==========================================================
local espData = {}

local function createESP(player)
    if player == LocalPlayer then return end
    if espData[player] then return end

    local nameText = Drawing.new("Text")
    nameText.Size    = 16
    nameText.Center  = true
    nameText.Outline = true
    nameText.Font    = 2
    nameText.Color   = Color3.fromRGB(255, 255, 255)
    nameText.Visible = false

    local distText = Drawing.new("Text")
    distText.Size    = 14
    distText.Center  = true
    distText.Outline = true
    distText.Font    = 2
    distText.Color   = Color3.fromRGB(200, 200, 200)
    distText.Visible = false

    local hpBg = Drawing.new("Square")
    hpBg.Filled       = true
    hpBg.Color        = Color3.fromRGB(20, 20, 20)
    hpBg.Transparency = 0.4
    hpBg.Visible      = false

    local hpFill = Drawing.new("Square")
    hpFill.Filled       = true
    hpFill.Color        = Color3.fromRGB(0, 255, 0)
    hpFill.Transparency = 0
    hpFill.Visible      = false

    local conn = RunService.RenderStepped:Connect(function()
        local char = player.Character
        if not char then
            nameText.Visible = false
            distText.Visible = false
            hpBg.Visible     = false
            hpFill.Visible   = false
            return
        end

        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        if not head or not hum or not hrp or hum.Health <= 0 then
            nameText.Visible = false
            distText.Visible = false
            hpBg.Visible     = false
            hpFill.Visible   = false
            return
        end

        local myChar = LocalPlayer.Character
        local myHrp  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local dist   = myHrp and (hrp.Position - myHrp.Position).Magnitude or 0

        if Config.ESPMaxDist > 0 and dist > Config.ESPMaxDist then
            nameText.Visible = false
            distText.Visible = false
            hpBg.Visible     = false
            hpFill.Visible   = false
            return
        end

        local headPos = head.Position + Vector3.new(0, 1.5, 0)
        local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
        if not onScreen or screenPos.Z <= 0 then
            nameText.Visible = false
            distText.Visible = false
            hpBg.Visible     = false
            hpFill.Visible   = false
            return
        end

        local sx, sy = screenPos.X, screenPos.Y

        if Config.ESPName then
            nameText.Text = player.Name
            nameText.Color = isSameTeam(player)
                and Color3.fromRGB(0, 255, 0)
                or Color3.fromRGB(255, 255, 255)
            nameText.Position = Vector2.new(sx, sy - 30)
            nameText.Visible = true
        else
            nameText.Visible = false
        end

        if Config.ESPHealth then
            local maxHp = hum.MaxHealth > 0 and hum.MaxHealth or 100
            local pct   = math.clamp(hum.Health / maxHp, 0, 1)

            local barW = 60
            local barH = 5

            hpBg.Size     = Vector2.new(barW, barH)
            hpBg.Position = Vector2.new(sx - barW / 2, sy - 14)
            hpBg.Visible  = true

            local fillColor
            if pct > 0.6 then
                fillColor = Color3.fromRGB(0, 220, 60)
            elseif pct > 0.3 then
                fillColor = Color3.fromRGB(255, 200, 0)
            else
                fillColor = Color3.fromRGB(255, 40, 40)
            end

            hpFill.Color    = fillColor
            hpFill.Size     = Vector2.new(barW * pct, barH)
            hpFill.Position = Vector2.new(sx - barW / 2, sy - 14)
            hpFill.Visible  = true
        else
            hpBg.Visible   = false
            hpFill.Visible = false
        end

        if Config.ESPDistance then
            distText.Text = string.format("[%d studs]  %.0f/%.0f HP", math.floor(dist), hum.Health, hum.MaxHealth)
            distText.Position = Vector2.new(sx, sy + 4)
            distText.Visible = true
        else
            distText.Visible = false
        end
    end)

    espData[player] = {
        nameText = nameText,
        distText = distText,
        hpBg     = hpBg,
        hpFill   = hpFill,
        conn     = conn,
    }
end

local function removeESP(player)
    local d = espData[player]
    if not d then return end
    pcall(function() d.conn:Disconnect() end)
    pcall(function() d.nameText:Remove() end)
    pcall(function() d.distText:Remove() end)
    pcall(function() d.hpBg:Remove() end)
    pcall(function() d.hpFill:Remove() end)
    espData[player] = nil
end

local function refreshAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if Config.ESPName or Config.ESPHealth or Config.ESPDistance then
                if not espData[plr] then
                    createESP(plr)
                end
            else
                removeESP(plr)
            end
        end
    end
end


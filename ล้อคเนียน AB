local hue = 0

RunService.RenderStepped:Connect(function(dt)
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius   = Config.FOVSize
    FOVCircle.Visible  = Config.RainbowFOV or Config.HeadLock

    if Config.RainbowFOV then
        hue = (hue + dt * 0.4) % 1
        FOVCircle.Color = Color3.fromHSV(hue, 1, 1)
    else
        FOVCircle.Color = Color3.fromRGB(0, 255, 100)
    end
end)

RunService.RenderStepped:Connect(function()
    if not Config.HeadLock then return end
    if not LocalPlayer.Character then return end

    local target = getClosestTarget()
    if not target then return end

    local camPos    = Camera.CFrame.Position
    local targetPos = target.Head.Position
    local dir       = (targetPos - camPos).Unit
    local newCF     = CFrame.new(camPos, camPos + dir)

    Camera.CFrame = Camera.CFrame:Lerp(newCF, Config.Smoothness)
end)

task.spawn(function()
    while true do
        task.wait(1)

        if Config.ESPName or Config.ESPHealth or Config.ESPDistance then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and not espData[plr] then
                    createESP(plr)
                end
            end
        else
            for plr in pairs(espData) do
                removeESP(plr)
            end
        end
    end
end)

